# Copy this file to .env and fill in the values
PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase > Connect > "Session pooler" connection string (replace [YOUR-PASSWORD], brackets included, with the real DB password)
DATABASE_URL=

# A long random string nobody can guess (generate one with the command below)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase project URL, e.g. https://xxxx.supabase.co (Project Settings > API, or the Connect dialog)
SUPABASE_URL=
# Secret key (sb_secret_...) from Project Settings > API Keys. Server only: never put it in the frontend or in git.
SUPABASE_SECRET_KEY=
# Name of the private Storage bucket that holds the photos
SUPABASE_BUCKET=
